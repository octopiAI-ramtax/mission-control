# Next.js (Mission Control)

# Public URL of your Supabase project
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side service role key (DO NOT expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Used for middleware/session cookies (any strong random string)
SUPABASE_JWT_SECRET=

# Optional: set this if you're self-hosting behind a proxy
NEXT_PUBLIC_SITE_URL=http://localhost:3000
